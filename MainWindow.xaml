                                                    Padding="10,8" MinHeight="48" Margin="0,6,0,6"/>
                                            <Grid Grid.Row="2" Margin="0,0,0,6" MinHeight="54">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="InstallAppUpdateButton" Grid.Column="0"
                                                        Style="{StaticResource SettingsSecondaryButton}"
                                                        Click="InstallAppUpdate_Click" IsEnabled="False"
                                                        HorizontalContentAlignment="Center" MinHeight="54"
                                                        Padding="6,4">
                                                    <StackPanel Orientation="Vertical"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="↓" FontSize="20"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="Install update" FontSize="12"
                                                                       FontWeight="Bold" TextAlignment="Center"/>
                                                            <TextBlock Text="Download &amp; install" FontSize="10.5"
                                                                       Style="{StaticResource SettingsCaption}"
                                                                       TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="ChangeLogButton" Grid.Column="2"
                                                        Style="{StaticResource SettingsSecondaryButton}"
                                                        Click="OpenChangeLog_Click"
                                                        HorizontalContentAlignment="Center" MinHeight="54"
                                                        Padding="6,4">
                                                    <StackPanel Orientation="Vertical"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="☷" FontSize="18"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="Release notes" FontSize="12"
                                                                       FontWeight="Bold" TextAlignment="Center"/>
                                                            <TextBlock Text="See what's new" FontSize="10.5"
                                                                       Style="{StaticResource SettingsCaption}"
                                                                       TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <StackPanel Grid.Row="3">
                                                <ProgressBar x:Name="AppUpdateProgressBar" Minimum="0" Maximum="100"
                                                             Height="8" Visibility="Collapsed" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="AppUpdateProgressText"
                                                           Style="{StaticResource SettingsCaption}"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsCard}"
                                        Margin="0,2,4,0" Padding="10">
                                    <Grid VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SettingsPurpleIconPlate}" Width="40" Height="40" Padding="0">
                                                <TextBlock Text="&lt;/&gt;" Foreground="{DynamicResource Settings.PurpleAccentBrush}"
                                                           FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Developer Mode" Style="{StaticResource SettingsHeading}"/>
                                                <TextBlock Text="Developer features and testing." Style="{StaticResource SettingsCaption}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                            <Border Style="{StaticResource SettingsInset}" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="♙" Foreground="{DynamicResource Settings.AccentTextBrush}"
                                                               FontSize="19" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="DeveloperModeStatusText" Text="Developer Mode is disabled"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Settings.TextBrush}"/>
                                                        <TextBlock Text="Enable developer mode for advanced features."
                                                                   Style="{StaticResource SettingsCaption}" FontSize="12"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="DeveloperModeToggle" Grid.Column="2"
                                                              Style="{StaticResource SettingsToggle}"
                                                              Click="DeveloperMode_Click"
                                                              ToolTip="Requires the private developer password."/>
                                                </Grid>
                                            </Border>
                                            <StackPanel x:Name="DeveloperToolsPanel" Visibility="Collapsed" Margin="0,5,0,0">
                                                <TextBlock Text="Developer notifications ☺" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Settings.MutedTextBrush}"
                                                           Margin="1,0,0,3"/>
                                                <Button x:Name="DeveloperNotificationTestButton"
                                                        Content="Send test notification to this PC"
                                                        Style="{StaticResource SettingsAccentButton}"
                                                        HorizontalAlignment="Stretch"
                                                        MinHeight="50"
                                                        Click="DeveloperNotificationTest_Click"/>
                                                <TextBlock x:Name="DeveloperNotificationStatusText"
                                                           Style="{StaticResource SettingsCaption}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCard}"
                                        Margin="2,2,2,0" Padding="10">
                                    <Grid VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SettingsCyanIconPlate}" Width="40" Height="40" Padding="0">
                                                <TextBlock Text="▣" Foreground="{DynamicResource Settings.CyanAccentBrush}"
                                                           FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Feedback &amp; Support" Style="{StaticResource SettingsHeading}"/>
                                                <TextBlock Text="Help improve Nova or report an issue."
                                                           Style="{StaticResource SettingsCaption}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource SettingsSecondaryButton}"
                                                Click="SuggestFeature_Click" HorizontalContentAlignment="Stretch"
                                                MinHeight="150" Padding="12,14">
                                                <Grid>
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <Border Style="{StaticResource SettingsAmberIconPlate}"
                                                                Width="54" Height="54" Padding="0"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Text="☼"
                                                                       Foreground="{DynamicResource Settings.AmberAccentBrush}"
                                                                       FontSize="27" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Suggest a feature" FontSize="14"
                                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                                   TextAlignment="Center" Margin="0,12,0,2"/>
                                                        <TextBlock Text="Share an idea to make Nova even better."
                                                                   Style="{StaticResource SettingsCaption}"
                                                                   FontSize="12" TextWrapping="Wrap"
                                                                   TextAlignment="Center" MaxWidth="190"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource SettingsSecondaryButton}"
                                                Click="ReportBug_Click" HorizontalContentAlignment="Stretch"
                                                MinHeight="150" Padding="12,14">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Border Style="{StaticResource SettingsRoseIconPlate}"
                                                            Width="54" Height="54" Padding="0"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="⚒"
                                                                   Foreground="{DynamicResource Settings.RoseAccentBrush}"
                                                                   FontSize="25" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Report a bug" FontSize="14"
                                                               FontWeight="Bold" TextWrapping="Wrap"
                                                               TextAlignment="Center" Margin="0,12,0,2"/>
                                                    <TextBlock Text="Tell us what happened so we can fix it."
                                                               Style="{StaticResource SettingsCaption}"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               TextAlignment="Center" MaxWidth="190"/>
                                                </StackPanel>
                                            </Grid>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsCard}"
                                        Margin="2,2,0,0" Padding="10">
                                    <Grid VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SettingsGreenIconPlate}" Width="40" Height="40" Padding="0">
                                                <TextBlock Text="ⓘ" Foreground="{DynamicResource Settings.GreenAccentBrush}"
                                                           FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="About Nova" Style="{StaticResource SettingsHeading}"/>
                                                <TextBlock Text="App and system information." Style="{StaticResource SettingsCaption}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,7,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource SettingsInset}" MinHeight="36"
                                                    Padding="10,4" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="▣" Foreground="{DynamicResource Settings.AccentTextBrush}"
                                                               FontSize="15" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="Installed version"
                                                               Style="{StaticResource SettingsCaption}" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AboutVersionText" Grid.Column="2" Text="Nova Manager"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Settings.TextBrush}"
                                                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Style="{StaticResource SettingsInset}" MinHeight="36"
                                                    Padding="10,4" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="⌕" Foreground="{DynamicResource Settings.AccentTextBrush}"
                                                               FontSize="15" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="Last update check"
                                                               Style="{StaticResource SettingsCaption}" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AboutLastUpdateCheckText" Grid.Column="2" Text="Not checked yet"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Settings.TextBrush}"
                                                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="2" Style="{StaticResource SettingsInset}" MinHeight="36"
                                                    Padding="10,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="▦" Foreground="{DynamicResource Settings.AccentTextBrush}"
                                                               FontSize="15" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="Operating system"
                                                               Style="{StaticResource SettingsCaption}" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AboutSystemText" Grid.Column="2" Text="Unavailable"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Settings.TextBrush}"
                                                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="3" Style="{StaticResource SettingsInset}" MinHeight="36"
                                                    Padding="10,4" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="▤" Foreground="{DynamicResource Settings.AccentTextBrush}"
                                                               FontSize="15" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="App architecture"
                                                               Style="{StaticResource SettingsCaption}" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AboutArchitectureText" Grid.Column="2" Text="64-bit"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Settings.TextBrush}"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="4" Margin="2,5,2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nova Manager · Faster, cleaner, smarter"
                                                           Style="{StaticResource SettingsCaption}" FontSize="10.5"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="View release details  ›"
                                                        Style="{StaticResource SettingsSecondaryButton}"
                                                        Click="OpenChangeLog_Click" Padding="8,5"
                                                        MinHeight="30" FontSize="10.5"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                            <Border Grid.Row="2" Style="{StaticResource SettingsCard}" MinHeight="58"
                                    Margin="0,8,0,0" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚀" Foreground="{DynamicResource Settings.AccentTextBrush}"
                                               FontSize="32" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Nova — Faster • Cleaner • Smarter"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource Settings.TextBrush}"/>
                                        <TextBlock Text="Keep your system in top shape and get the most out of your PC."
                                                   Style="{StaticResource SettingsCaption}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="NOVA" Foreground="{DynamicResource Settings.AccentTextBrush}"
                                                   FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="SOFTWARE MANAGER" Style="{StaticResource SettingsCaption}"
                                                   FontSize="11.5" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" Foreground="{DynamicResource ThemeBrush_98A3B4}" FontSize="12.5"
                       Margin="2,12,0,0"/>
        </Grid>
    </Grid>
</Window>
