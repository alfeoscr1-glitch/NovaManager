                                                               Grid.Column="1"
                                                               Text="Check GitHub for the latest Nova release."
                                                               Style="{StaticResource SettingsCaption}"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                            <Button x:Name="CheckAppUpdateButton" Grid.Row="1"
