                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource SettingsInset}" Padding="10,7" Margin="0,0,0,6">
                                                <Grid MinHeight="48">
