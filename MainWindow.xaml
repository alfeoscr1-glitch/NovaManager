                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Settings.TextBrush}"/>
                                                        <TextBlock Text="Keep Nova running in the background."
                                                                   Style="{StaticResource SettingsCaption}" FontSize="12"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="MinimizeToTrayToggle" Grid.Column="2"
                                                              Style="{StaticResource SettingsToggle}" Tag="MinimizeToTray"
