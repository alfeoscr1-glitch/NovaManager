                                                                       FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                                            <TextBlock x:Name="SelectedTempCountText" Text="0 files · 0 locations"
                                                                       Foreground="{DynamicResource ThemeBrush_58667B}" FontSize="10.5"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                        CornerRadius="12" Padding="15" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <TextBlock Text="What happens?" Foreground="{DynamicResource ThemeBrush_29364B}" FontSize="13.5" FontWeight="Bold"/>
                                                        <TextBlock Text="Nova removes only the files selected from this scan. Folders are never removed."
                                                                   Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="10.5" Margin="0,5,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                        CornerRadius="12" Padding="15" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <TextBlock Text="✓  Recommended" Foreground="{DynamicResource ThemeBrush_5669E8}" FontSize="12.5" FontWeight="Bold"/>
                                                        <TextBlock Text="Changed, locked, protected and linked files are skipped. Cache files can be recreated by Windows or apps."
                                                                   Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="10.5" Margin="0,5,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                        CornerRadius="12" Padding="15" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <TextBlock Text="Before you continue" Foreground="{DynamicResource ThemeBrush_29364B}" FontSize="12.5" FontWeight="Bold"/>
                                                        <TextBlock Text="• Save your work first.&#10;• Close browsers to release more cache files.&#10;• Nova asks you to confirm before removing files."
                                                                   Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="10.5" Margin="0,5,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                        CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="Review selected locations" Foreground="{DynamicResource ThemeBrush_29364B}" FontSize="12.5" FontWeight="Bold"/>
                                                        <TextBlock x:Name="SelectedTempCategoriesText" Text="No categories selected"
                                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10.5" Margin="0,5,0,5"/>
                                                        <ItemsControl ItemsSource="{Binding SelectedCleanupCategories}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,3">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeBrush_5B6A81}" FontSize="10.5"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding SelectedFormattedBytes}" Foreground="{DynamicResource ThemeBrush_526078}"
                                                                                   FontSize="10.5" FontWeight="SemiBold"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                        <StackPanel Grid.Row="1">
                                        <Button x:Name="CleanButton" Content="Clean Selected Files"
                                                Background="{DynamicResource ThemeBrush_5669E8}"
                                                IsEnabled="False" Margin="0,2,0,0" Click="CleanButton_Click"/>
                                        <Button x:Name="TempScanButton" Content="↻  Scan Again"
                                                Click="ScanButton_Click" Style="{StaticResource SecondaryButton}"
                                                Margin="0,7,0,0"/>
                                        <TextBlock x:Name="CleanupStatusText" Text="" Foreground="{DynamicResource ThemeBrush_7F8BA0}"
                                                   FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <Grid x:Name="FolderMapPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Browse your PC" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock Text="Read-only folder explorer. Scan lists this location's immediate contents; search looks recursively underneath it. Nothing here can be deleted."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="13.5" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                        <Button x:Name="FolderMapScanButton" DockPanel.Dock="Right" Content="Scan folder" Click="ScanFolderMap_Click"
                                                Margin="8,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="Up" Style="{StaticResource SecondaryButton}"
                                                Click="FolderMapUp_Click" Margin="8,0,0,0" Padding="12,9"/>
                                        <ComboBox x:Name="FolderRootCombo" DockPanel.Dock="Left" Width="190"
                                                  VerticalContentAlignment="Center" MinHeight="38" Margin="0,0,8,0"
                                                  SelectionChanged="FolderRootCombo_SelectionChanged"/>
                                        <TextBox x:Name="FolderPathTextBox" VerticalContentAlignment="Center" MinHeight="38"
                                                 Padding="10,6" ToolTip="Type or paste a folder path"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                                        <Button x:Name="CancelFolderSearchButton" DockPanel.Dock="Right" Content="Cancel search"
                                                Style="{StaticResource SecondaryButton}" Click="CancelFolderSearch_Click"
                                                IsEnabled="False" Margin="8,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="Search names" Click="SearchFolderMap_Click"
                                                Margin="8,0,0,0"/>
                                        <TextBox x:Name="FolderSearchTextBox" VerticalContentAlignment="Center" MinHeight="36"
                                                 Padding="10,5" ToolTip="Search file and folder names under the current location"
                                                 KeyDown="FolderSearchTextBox_KeyDown"/>
                                    </DockPanel>
                                    <DataGrid Grid.Row="3" x:Name="StorageFoldersGrid" ItemsSource="{Binding StorageFolders}"
                                              SelectionChanged="StorageFoldersGrid_SelectionChanged"
                                              MouseDoubleClick="StorageFoldersGrid_MouseDoubleClick" MinHeight="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="180"/>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="155"/>
                                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Path}" Width="2*"/>
                                            <DataGridTextColumn Header="SIZE / USED" Binding="{Binding FormattedBytes}" Width="100"/>
                                            <DataGridTemplateColumn Header="OPEN HERE" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Enter" Padding="8,6" Tag="{Binding}" IsEnabled="{Binding CanEnter}"
                                                                Style="{StaticResource SecondaryButton}" Click="EnterStorageEntry_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="EXPLORER" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Open in Explorer" Padding="8,6" Tag="{Binding}"
                                                                Style="{StaticResource SecondaryButton}" Click="BrowseStorageFolder_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="StorageMapStatusText" Grid.Row="4" Text="Choose a quick location or type a path, then scan. Search is recursive and read-only."
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid x:Name="ShortcutsPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Games and software shortcuts" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock Text="Choose your shortcuts folder. Nova checks shortcut targets and never moves or deletes shortcuts."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="13.5" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Choose folder…" Style="{StaticResource SecondaryButton}"
                                                    Click="ChooseShortcutsFolder_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="ShortcutsScanButton" Content="Scan shortcuts" Click="ScanShortcuts_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ShortcutsFolderPathText" Text="No shortcuts folder selected."
                                                   VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_53627A}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DataGrid Grid.Row="2" x:Name="ShortcutsGrid" ItemsSource="{Binding Shortcuts}"
                                              SelectionChanged="ShortcutsGrid_SelectionChanged" MinHeight="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SHORTCUT" Binding="{Binding Name}" Width="160"/>
                                            <DataGridTextColumn Header="SHORTCUT PATH" Binding="{Binding Path}" Width="*"/>
                                            <DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="*"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="135"/>
                                            <DataGridTemplateColumn Header="BROWSE" Width="88">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Open link" Padding="8,6" Tag="{Binding}"
                                                                Style="{StaticResource SecondaryButton}" Click="BrowseShortcut_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="ShortcutsStatusText" Grid.Row="3" Text="Target status is an observation, not a guarantee that the app is installed or working."
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Settings">
                    <Grid x:Name="SettingsPage" Margin="0,0,0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource SettingsCard}"
                                MinHeight="112" Margin="0,0,0,10" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsIconPlate}" Width="54" Height="54" Padding="0">
