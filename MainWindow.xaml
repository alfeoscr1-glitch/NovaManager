<Window x:Class="NovaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Software Manager" Height="850" Width="1320" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeBrush_F2F5FA}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AEB9CB}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ThemeBrush_293754}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FFFFFF}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_E8ECF3}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="AppearanceComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FFFFFF}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_202A3B}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_E8ECF3}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeBrush_202A3B}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_202A3B}"/>
                        <Setter Property="Background" Value="{DynamicResource ThemeBrush_FFFFFF}"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanupCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinWidth="20" MinHeight="20">
                            <Border x:Name="CheckBoxBorder" Width="18" Height="18" CornerRadius="4"
                                    Background="{DynamicResource ThemeBrush_FFFFFF}"
                                    BorderBrush="{DynamicResource ThemeBrush_7F8BA0}" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="24,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource ThemeBrush_5669E8}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_5669E8}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FFFFFF}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_202A3B}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeBrush_172238}" Padding="24,0">
            <Grid Height="68">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource ThemeBrush_5669E8}">
                        <TextBlock Text="N" Foreground="White" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NOVA" Foreground="White" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="SOFTWARE MANAGER" Foreground="{DynamicResource ThemeBrush_91A0BA}" FontSize="9"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" Background="{DynamicResource ThemeBrush_5669E8}" Foreground="White"
                            Click="OverviewNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◫" Width="22"/><TextBlock Text="Overview"/></StackPanel>
                    </Button>
                    <Button x:Name="SoftwareNavButton" Style="{StaticResource NavButton}" Click="SoftwareNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="22"/><TextBlock Text="My software"/></StackPanel>
                    </Button>
                    <Button x:Name="UpdatesNavButton" Style="{StaticResource NavButton}" Click="UpdatesNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⟳" Width="22"/><TextBlock Text="Updates"/></StackPanel>
                    </Button>
                    <Button x:Name="CleanupNavButton" Style="{StaticResource NavButton}" Click="CleanupNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▱" Width="22"/><TextBlock Text="Storage &amp; cleanup"/></StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="SettingsGearButton" Grid.Column="2" ToolTip="Settings" Click="SettingsNav_Click"
                        Style="{StaticResource NavButton}" Padding="5,4" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid MinWidth="40" MinHeight="38">
                        <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="UpdateBadgeBorder" Background="#D84C5A" BorderBrush="{DynamicResource ThemeBrush_172238}"
                                BorderThickness="1" CornerRadius="9" MinWidth="20" Height="18"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="UpdateBadgeText" Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="36,26,36,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Good morning" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush_202A3B}"/>
                    <TextBlock x:Name="PageSubtitle" Text="Your software at a glance. Updates and cleanup stay in your control."
                               FontSize="13" Foreground="{DynamicResource ThemeBrush_7F8BA0}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}"
                            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LAST SCAN" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LastScanText" Text="Not scanned yet" Foreground="{DynamicResource ThemeBrush_39465B}"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ScanButton" Content="Scan this PC" Click="ScanButton_Click" MinWidth="130"/>
                </StackPanel>
            </Grid>
            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                        SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <Border CornerRadius="14" Padding="25" Margin="0,0,0,18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource ThemeColor_5268E8}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource ThemeColor_7657DF}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="UPDATE CHECK" Foreground="{DynamicResource ThemeBrush_DCE1FF}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="HeroTitle" Text="Scan for updates outside Microsoft Store"
                                                   Foreground="White" FontSize="21" FontWeight="Bold" Margin="0,10,0,5"/>
                                        <TextBlock Text="Checks for update candidates in the winget source, not the Microsoft Store catalog."
                                                   Foreground="{DynamicResource ThemeBrush_E6E8FF}" FontSize="12" TextWrapping="Wrap"/>
                                        <Button Content="Open updates" HorizontalAlignment="Left" Margin="0,17,0,0"
                                                Background="White" Foreground="{DynamicResource ThemeBrush_4F5FD0}" Click="UpdatesNav_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="⟳" FontSize="53" Foreground="#FFFFFF" Opacity="0.42"
                                               VerticalAlignment="Center" Margin="22,0,10,0"/>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,24">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="INSTALLED SOFTWARE" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InstalledCountText" Text="—" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock Text="apps and games found" Foreground="{DynamicResource ThemeBrush_98A3B5}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="12,0">
                                    <StackPanel>
                                        <TextBlock Text="WINGET UPDATES" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UpdatesCountText" Text="—" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock Text="found in the winget source" Foreground="{DynamicResource ThemeBrush_98A3B5}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TEMP FILES FOUND" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TempSizeText" Text="—" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TempCountText" Text="Preview before removing" Foreground="{DynamicResource ThemeBrush_98A3B5}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Updates to review" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock x:Name="UpdatesSummaryText" Text="Run a scan to check apps in the winget source."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,8,0,18" TextWrapping="Wrap"/>
                                        <DataGrid x:Name="OverviewUpdatesGrid" Height="176" ItemsSource="{Binding Updates}"
                                                  HeadersVisibility="None" RowHeight="42">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Version" Binding="{Binding AvailableVersion}" Width="100"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Temporary files" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Scans %TEMP% and the Windows Temp folder. Locked or protected files may be skipped."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,8,0,18" TextWrapping="Wrap"/>
                                        <Border Background="{DynamicResource ThemeBrush_F6F8FC}" CornerRadius="9" Padding="13">
                                            <StackPanel>
                                                <TextBlock Text="%TEMP% and Windows\Temp" Foreground="{DynamicResource ThemeBrush_39465B}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock x:Name="TempSummaryText" Text="Run a scan to see the removable file estimate."
                                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="My software">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="Installed apps and games" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Detected from Windows installed-program records and your Windows app packages."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Software}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="*"/>
                                    <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="120"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Updates">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="Available updates" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Scans Nova Manager, winget, Microsoft Store packages and Windows Update. App updates remain under your control; Windows updates are never installed here."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource ThemeBrush_F7F8FB}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nova Manager" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock x:Name="NovaUpdateScanStatusText" Text="Scan to check for a Nova update."
                                                       Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Nova update settings" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center" Click="OpenNovaUpdateSettings_Click"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource ThemeBrush_F7F8FB}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Windows Update" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock x:Name="WindowsUpdateScanStatusText" Text="Scan to check Windows Update."
                                                       Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="OpenWindowsUpdateButton" Grid.Column="1" Content="Open Windows Update"
                                                Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                                Visibility="Collapsed" Click="OpenWindowsUpdate_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StoreUpdateScanStatusText"
                                           Text="Microsoft Store updates are checked through the Windows Package Manager Store source."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11" Margin="0,0,0,4"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="UpdatesGrid" ItemsSource="{Binding Updates}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="PACKAGE ID" Binding="{Binding Id}" Width="1.4*"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="105"/>
                                    <DataGridTextColumn Header="CURRENT" Binding="{Binding CurrentVersion}" Width="120"/>
                                    <DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableVersion}" Width="120"/>
                                    <DataGridTemplateColumn Header="ACTION" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Update" Padding="12,7" Tag="{Binding}" Click="UpdateButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Storage &amp; cleanup">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Storage &amp; organization" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Explore where space is used. Unknown means needs review, not safe to delete."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,7,0,12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="TempSectionButton" Content="Temporary files" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="TempSection_Click"/>
                                <Button x:Name="FolderMapSectionButton" Content="Folder map" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="FolderMapSection_Click"/>
                                <Button x:Name="ShortcutsSectionButton" Content="Shortcuts" Style="{StaticResource SecondaryButton}"
                                        Click="ShortcutsSection_Click"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid x:Name="TempCleanupPanel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,20,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                            <TextBlock Text="Temporary files and caches" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="Scan the listed Windows, graphics, and browser-cache locations. Select the files or locations you want, then confirm Cleanup files."
                                                       Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="{DynamicResource ThemeBrush_F4F7FF}" BorderBrush="{DynamicResource ThemeBrush_E5EBFA}" BorderThickness="1"
                                                CornerRadius="10" Padding="18,16" Margin="0,0,0,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="ⓘ" FontSize="22" Foreground="{DynamicResource ThemeBrush_5669E8}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Cleanup files" Foreground="{DynamicResource ThemeBrush_25334A}" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text="Only checked files from these approved locations are removed. Browser caches may be in use until Edge or Chrome is closed."
                                                               Foreground="{DynamicResource ThemeBrush_71809A}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataGrid Grid.Row="2" x:Name="CleanupCategoriesGrid" ItemsSource="{Binding CleanupCategories}"
                                                  HeadersVisibility="None" MinHeight="220" RowHeight="88"
                                                  SelectionUnit="FullRow" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="6,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="38"/>
                                                                    <ColumnDefinition Width="44"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="112"/>
                                                                    <ColumnDefinition Width="125"/>
                                                                    <ColumnDefinition Width="104"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEnabled="{Binding IsSelectedAllowed}" Tag="{Binding}"
                                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                          Style="{StaticResource CleanupCheckBox}"
                                                                          Click="CleanupCategoryCheckBox_Click"/>
                                                                <Border Grid.Column="1" Width="29" Height="29" CornerRadius="8"
                                                                        Background="{DynamicResource ThemeBrush_EEF2FF}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Icon}" FontSize="15" Foreground="{DynamicResource ThemeBrush_596DE0}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="12" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="10"
                                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="9"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                    <TextBlock Text="Estimated size" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="9"/>
                                                                    <TextBlock Text="{Binding FormattedBytes}" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="11" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} files}" Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="9"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="4" Background="{DynamicResource ThemeBrush_F0F3F8}" CornerRadius="12"
                                                                        Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ThemeBrush_64738A}" FontSize="9" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Button Grid.Column="5" Content="Open folder" Padding="7,6" Tag="{Binding}"
                                                                        IsEnabled="{Binding IsAvailable}" Style="{StaticResource SecondaryButton}"
                                                                        Click="BrowseCleanupCategory_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Grid.Row="4" Margin="0,16,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Detailed scan results" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock x:Name="TempSelectionSummaryText" Text="Scan to review supported temporary and cache locations."
                                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="ToggleTempFilesButton" Grid.Column="1" Content="View all files"
                                                    Style="{StaticResource SecondaryButton}" Padding="10,7" Click="ToggleTempFiles_Click"/>
                                        </Grid>
                                        <DataGrid Grid.Row="4" x:Name="TempFilesGrid" ItemsSource="{Binding TempFiles}"
                                                  MinHeight="90" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  SelectionUnit="FullRow" SelectionMode="Single"
                                                  Visibility="Collapsed">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="REMOVE" Width="68">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Tag="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Style="{StaticResource CleanupCheckBox}"
                                                                      Click="TempFileCheckBox_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="FILE PATH" Binding="{Binding Path}" Width="*"/>
                                                <DataGridTextColumn Header="SIZE" Binding="{Binding FormattedBytes}" Width="78"/>
                                                <DataGridTextColumn Header="LAST MODIFIED" Binding="{Binding LastWriteTimeUtc, StringFormat={}{0:g}}" Width="125"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="5" Text="Only checked files shown in this scan can be removed. Changed, locked, protected, and linked items are skipped. Folders are never deleted."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                CornerRadius="12" Padding="22" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="Cleanup summary" Foreground="{DynamicResource ThemeBrush_29364B}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock x:Name="SelectedTempSizeText" Text="0 B" Foreground="{DynamicResource ThemeBrush_25334A}"
                                                           FontSize="26" FontWeight="Bold" Margin="0,14,0,2"/>
                                                <TextBlock Text="selected to be freed (estimate)" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10"/>
                                                <Separator Margin="0,16"/>
                                                <TextBlock x:Name="SelectedTempCountText" Text="0 files · 0 locations selected"
                                                           Foreground="{DynamicResource ThemeBrush_58667B}" FontSize="11"/>
                                                <Border Background="{DynamicResource ThemeBrush_F0F5FF}" CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
                                                    <TextBlock Text="Locked or protected files may be skipped. This keeps Windows and running apps stable."
                                                               Foreground="{DynamicResource ThemeBrush_617391}" FontSize="10" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                CornerRadius="12" Padding="22">
                                            <StackPanel>
                                                <TextBlock Text="Review before removal" Foreground="{DynamicResource ThemeBrush_29364B}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock x:Name="SelectedTempCategoriesText" Text="No categories selected"
                                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10" Margin="0,10,0,10"/>
                                                <ItemsControl ItemsSource="{Binding SelectedCleanupCategories}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,7">
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeBrush_5B6A81}" FontSize="10"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedFormattedBytes}" Foreground="{DynamicResource ThemeBrush_526078}"
                                                                           FontSize="10" FontWeight="SemiBold"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button x:Name="CleanButton" Content="Cleanup files" Background="{DynamicResource ThemeBrush_5669E8}"
                                                        IsEnabled="False" Margin="0,13,0,0" Click="CleanButton_Click"/>
                                                <TextBlock x:Name="CleanupStatusText" Text="" Foreground="{DynamicResource ThemeBrush_7F8BA0}"
                                                           FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="TempScanButton" Content="Scan for cleanup" Click="ScanButton_Click"
                                                Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="FolderMapPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Browse your PC" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="Read-only folder explorer. Scan lists this location's immediate contents; search looks recursively underneath it. Nothing here can be deleted."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                        <Button x:Name="FolderMapScanButton" DockPanel.Dock="Right" Content="Scan folder" Click="ScanFolderMap_Click"
                                                Margin="8,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="Up" Style="{StaticResource SecondaryButton}"
                                                Click="FolderMapUp_Click" Margin="8,0,0,0" Padding="12,9"/>
                                        <ComboBox x:Name="FolderRootCombo" DockPanel.Dock="Left" Width="190"
                                                  VerticalContentAlignment="Center" MinHeight="38" Margin="0,0,8,0"
                                                  SelectionChanged="FolderRootCombo_SelectionChanged"/>
                                        <TextBox x:Name="FolderPathTextBox" VerticalContentAlignment="Center" MinHeight="38"
                                                 Padding="10,6" ToolTip="Type or paste a folder path"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                                        <Button x:Name="CancelFolderSearchButton" DockPanel.Dock="Right" Content="Cancel search"
                                                Style="{StaticResource SecondaryButton}" Click="CancelFolderSearch_Click"
                                                IsEnabled="False" Margin="8,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="Search names" Click="SearchFolderMap_Click"
                                                Margin="8,0,0,0"/>
                                        <TextBox x:Name="FolderSearchTextBox" VerticalContentAlignment="Center" MinHeight="36"
                                                 Padding="10,5" ToolTip="Search file and folder names under the current location"
                                                 KeyDown="FolderSearchTextBox_KeyDown"/>
                                    </DockPanel>
                                    <DataGrid Grid.Row="3" x:Name="StorageFoldersGrid" ItemsSource="{Binding StorageFolders}"
                                              SelectionChanged="StorageFoldersGrid_SelectionChanged"
                                              MouseDoubleClick="StorageFoldersGrid_MouseDoubleClick" MinHeight="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="180"/>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="155"/>
                                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Path}" Width="2*"/>
                                            <DataGridTextColumn Header="SIZE / USED" Binding="{Binding FormattedBytes}" Width="100"/>
                                            <DataGridTemplateColumn Header="OPEN HERE" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Enter" Padding="8,6" Tag="{Binding}" IsEnabled="{Binding CanEnter}"
                                                                Style="{StaticResource SecondaryButton}" Click="EnterStorageEntry_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="EXPLORER" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Open in Explorer" Padding="8,6" Tag="{Binding}"
                                                                Style="{StaticResource SecondaryButton}" Click="BrowseStorageFolder_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="StorageMapStatusText" Grid.Row="4" Text="Choose a quick location or type a path, then scan. Search is recursive and read-only."
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid x:Name="ShortcutsPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Games and software shortcuts" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="Choose your shortcuts folder. Nova checks shortcut targets and never moves or deletes shortcuts."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Choose folder…" Style="{StaticResource SecondaryButton}"
                                                    Click="ChooseShortcutsFolder_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="ShortcutsScanButton" Content="Scan shortcuts" Click="ScanShortcuts_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ShortcutsFolderPathText" Text="No shortcuts folder selected."
                                                   VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_53627A}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DataGrid Grid.Row="2" x:Name="ShortcutsGrid" ItemsSource="{Binding Shortcuts}"
                                              SelectionChanged="ShortcutsGrid_SelectionChanged" MinHeight="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SHORTCUT" Binding="{Binding Name}" Width="160"/>
                                            <DataGridTextColumn Header="SHORTCUT PATH" Binding="{Binding Path}" Width="*"/>
                                            <DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="*"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="135"/>
                                            <DataGridTemplateColumn Header="BROWSE" Width="88">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Open link" Padding="8,6" Tag="{Binding}"
                                                                Style="{StaticResource SecondaryButton}" Click="BrowseShortcut_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="ShortcutsStatusText" Grid.Row="3" Text="Target status is an observation, not a guarantee that the app is installed or working."
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,12">
                            <Border Background="{DynamicResource ThemeBrush_172238}" CornerRadius="14"
                                    Padding="22" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="NOVA PREFERENCES" Foreground="{DynamicResource ThemeBrush_B9C4FF}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Make Nova yours" Foreground="White"
                                                       FontSize="23" FontWeight="Bold" Margin="0,5,10,3"/>
                                            <Button Content="&lt;/&gt;" Padding="9,5" MinWidth="42"
                                                    Background="{DynamicResource ThemeBrush_293754}"
                                                    Foreground="{DynamicResource ThemeBrush_B9C4FF}"
                                                    BorderBrush="{DynamicResource ThemeBrush_53627A}"
                                                    ToolTip="Developer mode — intended for the Nova developer only."
                                                    Click="DeveloperMode_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="Personalize how Nova looks and keep track of the latest changes."
                                                   Foreground="{DynamicResource ThemeBrush_ECF1FA}" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="14"
                                            Background="{DynamicResource ThemeBrush_293754}"
                                            VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="⚙" Foreground="{DynamicResource ThemeBrush_B9C4FF}"
                                                   FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="DeveloperModePanel" Style="{StaticResource Card}"
                                    Margin="0,0,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="DEVELOPER MODE / ADMIN MODE"
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Developer notifications" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                               FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="This area is for the Nova developer and is not intended for ordinary users. This local test only sends a notification to this PC; Nova does not have infrastructure to broadcast a notification to all installations."
                                               Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="12"
                                               Margin="0,7,0,14" TextWrapping="Wrap"/>
                                    <Button x:Name="DeveloperNotificationTestButton"
                                            Content="Send test notification to this PC"
                                            HorizontalAlignment="Left" Click="DeveloperNotificationTest_Click"/>
                                    <TextBlock x:Name="DeveloperNotificationStatusText"
                                               Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="11"
                                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="LatestReleaseNotesPanel" Style="{StaticResource Card}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="WHAT'S NEW" Foreground="{DynamicResource ThemeBrush_7F8BA0}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Latest release notes" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBrush_F0F3F8}"
                                            CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="LatestReleaseNotesTitleText" Foreground="{DynamicResource ThemeBrush_53627A}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="LatestReleaseNotesStatusText" Grid.Row="1" Grid.ColumnSpan="2"
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11"
                                               Margin="0,8,0,12" TextWrapping="Wrap"/>
                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1"
                                            Background="{DynamicResource ThemeBrush_E8ECF3}" Margin="0,0,0,12"/>
                                    <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2" MaxHeight="180"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="LatestReleaseNotesText" Foreground="{DynamicResource ThemeBrush_39465B}"
                                                   FontSize="12" LineHeight="20" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.25*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="PERSONALIZATION" Foreground="{DynamicResource ThemeBrush_7F8BA0}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Appearance" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Choose the theme that feels right. Nova remembers your choice."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12"
                                                   Margin="0,6,0,18" TextWrapping="Wrap"/>
                                        <TextBlock Text="COLOR THEME" Foreground="{DynamicResource ThemeBrush_53627A}"
                                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <ComboBox x:Name="AppearanceComboBox" Style="{StaticResource AppearanceComboBox}"
                                                      Foreground="Transparent">
                                                <ComboBoxItem Content="Light"/>
                                                <ComboBoxItem Content="Dark"/>
                                            </ComboBox>
                                            <TextBlock x:Name="AppearanceSelectionText" Text="Light"
                                                       Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                       Margin="10,0,34,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                        <TextBlock Text="Applies immediately and is saved for your next session."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11"
                                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="STAY CURRENT" Foreground="{DynamicResource ThemeBrush_7F8BA0}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Application updates" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Secure, verified updates delivered as a single Nova EXE."
                                                   Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12"
                                                   Margin="0,6,0,14" TextWrapping="Wrap"/>
                                        <Border Background="{DynamicResource ThemeBrush_F7F8FB}" CornerRadius="9"
                                                Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="INSTALLED VERSION" Foreground="{DynamicResource ThemeBrush_7F8BA0}"
                                                           FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="AppVersionText" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                           FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="AppUpdateStatusText" Text="Check GitHub for the latest Nova release."
                                                   Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="12"
                                                   Margin="0,0,0,14" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="AppUpdateProgressBar" Minimum="0" Maximum="100" Height="8"
                                                     Visibility="Collapsed" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="AppUpdateProgressText" Foreground="{DynamicResource ThemeBrush_53627A}"
                                                   FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                        <WrapPanel>
                                            <Button x:Name="CheckAppUpdateButton" Content="Check for updates"
                                                    Click="CheckAppUpdates_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="InstallAppUpdateButton" Content="Download and install"
                                                    Click="InstallAppUpdate_Click" IsEnabled="False"
                                                    Style="{StaticResource SecondaryButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{DynamicResource ThemeBrush_F0F3F8}" CornerRadius="9"
                                    Padding="13" Margin="0,16,0,0">
                                <TextBlock Text="Nova closes and reopens to finish installing an update. Temporary install files are cleaned up automatically."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="FEEDBACK &amp; SUPPORT" Foreground="{DynamicResource ThemeBrush_7F8BA0}"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Help improve Nova" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                               FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Send feedback directly to the Nova Manager GitHub repository. The first submission requires one-time GitHub authorization; later submissions are sent from Nova."
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12"
                                               Margin="0,6,0,14" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SUGGEST A FEATURE" Foreground="{DynamicResource ThemeBrush_53627A}"
                                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox x:Name="FeatureSuggestionTextBox" MinHeight="100" MaxLength="5000"
                                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top" Padding="10,8" Margin="0,0,0,10"
                                                     Background="{DynamicResource ThemeBrush_F7F8FB}"
                                                     Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                     BorderBrush="{DynamicResource ThemeBrush_E8ECF3}"
                                                     ToolTip="Describe the feature or improvement you'd like"/>
                                            <Button x:Name="FeatureSuggestionButton" Content="Send suggestion" Click="SendFeatureSuggestion_Click"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="REPORT A BUG" Foreground="{DynamicResource ThemeBrush_53627A}"
                                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox x:Name="BugReportTextBox" MinHeight="100" MaxLength="5000"
                                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top" Padding="10,8" Margin="0,0,0,10"
                                                     Background="{DynamicResource ThemeBrush_F7F8FB}"
                                                     Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                     BorderBrush="{DynamicResource ThemeBrush_E8ECF3}"
                                                     ToolTip="Describe what happened and what you expected"/>
                                            <Button x:Name="BugReportButton" Content="Send bug report" Click="SendBugReport_Click"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Please don't include passwords, access tokens, or other sensitive information. Bug reports include only the Nova and Windows versions."
                                               Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11"
                                               Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FeedbackStatusText" Foreground="{DynamicResource ThemeBrush_53627A}"
                                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" Foreground="{DynamicResource ThemeBrush_98A3B4}" FontSize="11"
                       Margin="2,12,0,0"/>
        </Grid>
    </Grid>
</Window>
