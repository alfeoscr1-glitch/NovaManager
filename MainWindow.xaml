                                            <Path Data="M0,79 L41,46 82,77 145,19 204,78 254,31 360,82 360,120 0,120 Z"
                                                  Fill="#303F80"/>
                                            <Path Data="M0,91 L73,56 117,87 185,53 243,91 303,63 360,91 360,120 0,120 Z"
                                                  Fill="#1B3268"/>
                                            <Path Data="M130,120 L192,73 248,120 Z" Fill="#D088B5" Opacity="0.87"/>
                                            <Path Data="M167,120 L202,82 229,120 Z" Fill="#FFD0CA" Opacity="0.45"/>
                                            <Path Data="M0,103 L69,91 133,103 202,88 278,104 360,91 360,120 0,120 Z"
                                                  Fill="#102346" Opacity="0.86"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SettingsInset}"
