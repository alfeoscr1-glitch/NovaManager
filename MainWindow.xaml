<Window x:Class="NovaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Manager" Height="900" Width="1500" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#07142B" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Settings.SurfaceBrush" Color="{DynamicResource ThemeColor_FFFFFF}" Opacity="0.88"/>
        <SolidColorBrush x:Key="Settings.InsetBrush" Color="{DynamicResource ThemeColor_F7F8FB}" Opacity="0.94"/>
        <SolidColorBrush x:Key="Settings.BorderBrush" Color="{DynamicResource ThemeColor_E8ECF3}" Opacity="0.78"/>
        <SolidColorBrush x:Key="Settings.TextBrush" Color="{DynamicResource ThemeColor_202A3B}"/>
        <SolidColorBrush x:Key="Settings.MutedTextBrush" Color="{DynamicResource ThemeColor_53627A}"/>
        <SolidColorBrush x:Key="Settings.AccentTextBrush" Color="{DynamicResource ThemeColor_5669E8}"/>
        <SolidColorBrush x:Key="Settings.PurpleAccentBrush" Color="{DynamicResource ThemeColor_7657DF}"/>
        <SolidColorBrush x:Key="Settings.CyanAccentBrush" Color="#00859F"/>
        <SolidColorBrush x:Key="Settings.GreenAccentBrush" Color="#178255"/>
        <SolidColorBrush x:Key="Settings.AmberAccentBrush" Color="#A65C00"/>
        <SolidColorBrush x:Key="Settings.RoseAccentBrush" Color="#B73868"/>
        <LinearGradientBrush x:Key="Settings.AccentButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2D68F7" Offset="0"/>
            <GradientStop Color="#5B4DFA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Settings.SunsetSkyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7954AF" Offset="0"/>
            <GradientStop Color="#DB80B5" Offset="0.56"/>
            <GradientStop Color="#FFA8AE" Offset="0.73"/>
            <GradientStop Color="#395A9A" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Settings.SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3675FF" BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsInset" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Settings.InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="SettingsIconPlate" TargetType="Border" BasedOn="{StaticResource SettingsInset}">
            <Setter Property="Background" Value="#D51D4BC2"/>
            <Setter Property="BorderBrush" Value="#D876A9FF"/>
        </Style>
        <Style x:Key="SettingsPurpleIconPlate" TargetType="Border" BasedOn="{StaticResource SettingsIconPlate}">
            <Setter Property="Background" Value="#D53F36B5"/>
            <Setter Property="BorderBrush" Value="#D89283FF"/>
        </Style>
        <Style x:Key="SettingsCyanIconPlate" TargetType="Border" BasedOn="{StaticResource SettingsIconPlate}">
            <Setter Property="Background" Value="#D5107395"/>
            <Setter Property="BorderBrush" Value="#D56CE8FF"/>
        </Style>
        <Style x:Key="SettingsGreenIconPlate" TargetType="Border" BasedOn="{StaticResource SettingsIconPlate}">
            <Setter Property="Background" Value="#D31D795D"/>
            <Setter Property="BorderBrush" Value="#D179F2C3"/>
        </Style>
        <Style x:Key="SettingsAmberIconPlate" TargetType="Border" BasedOn="{StaticResource SettingsIconPlate}">
            <Setter Property="Background" Value="#D3985A15"/>
            <Setter Property="BorderBrush" Value="#D9FFCF70"/>
        </Style>
        <Style x:Key="SettingsRoseIconPlate" TargetType="Border" BasedOn="{StaticResource SettingsIconPlate}">
            <Setter Property="Background" Value="#D399326A"/>
            <Setter Property="BorderBrush" Value="#D9FF8DC1"/>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingsCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Settings.MutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsAccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Settings.AccentButtonBrush}"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="46"/>
        </Style>
        <Style x:Key="SettingsSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Settings.InsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AEB9CB}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#183055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FFFFFF}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_E8ECF3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3675FF" BlurRadius="18" ShadowDepth="0" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppearanceComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Settings.SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Settings.TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <ToggleButton x:Name="DropDownToggle" Width="34" HorizontalAlignment="Right"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0,0 L 4,4 L 8,0"
                                                  Stroke="{DynamicResource Settings.MutedTextBrush}"
                                                  StrokeThickness="1.5" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade" StaysOpen="False"
                                   Width="{TemplateBinding ActualWidth}">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource Settings.SurfaceBrush}"
                                            BorderBrush="{DynamicResource Settings.BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"/>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Settings.TextBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource Settings.SurfaceBrush}"/>
                        <Setter Property="Padding" Value="7,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Settings.InsetBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanupCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_202A3B}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinWidth="20" MinHeight="20">
                            <Border x:Name="CheckBoxBorder" Width="18" Height="18" CornerRadius="4"
                                    Background="{DynamicResource ThemeBrush_FFFFFF}"
                                    BorderBrush="{DynamicResource ThemeBrush_7F8BA0}" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="24,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource ThemeBrush_5669E8}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_5669E8}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="ToggleTrack" Background="{DynamicResource Settings.BorderBrush}" CornerRadius="11"/>
                            <Ellipse x:Name="ToggleThumb" Width="16" Height="16"
                                     Fill="{DynamicResource Settings.TextBrush}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource Settings.TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FFFFFF}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_202A3B}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#061128" BorderBrush="#142747" BorderThickness="0,0,1,0" Padding="12,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,30">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#5669E8">
                        <TextBlock Text="N" Foreground="White" FontSize="25" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NOVA" Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="SOFTWARE MANAGER" Foreground="#91A0BA" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" Background="#203DAD" Foreground="White"
                            Click="OverviewNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="25" FontSize="18"/><TextBlock Text="Dashboard"/></StackPanel>
                    </Button>
                    <Button x:Name="SoftwareNavButton" Style="{StaticResource NavButton}" Click="SoftwareNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="25" FontSize="15"/><TextBlock Text="My software"/></StackPanel>
                    </Button>
                    <Button x:Name="UpdatesNavButton" Style="{StaticResource NavButton}" Click="UpdatesNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⟳" Width="25" FontSize="17"/><TextBlock Text="Updates"/></StackPanel>
                    </Button>
                    <Button x:Name="CleanupNavButton" Style="{StaticResource NavButton}" Click="CleanupNav_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▱" Width="25" FontSize="16"/><TextBlock Text="Storage &amp; Cleanup"/></StackPanel>
                    </Button>
                    <Button x:Name="SettingsGearButton" ToolTip="Settings" Click="SettingsNav_Click"
                            Style="{StaticResource NavButton}" Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"/>
                            <Border x:Name="UpdateBadgeBorder" Grid.Column="1" Background="#D84C5A" BorderBrush="#061128"
                                    BorderThickness="1" CornerRadius="8" MinWidth="18" Height="17"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="UpdateBadgeText" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="4,0,0,8">
                    <Border Height="1" Background="#1B2D4A" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#09D2A5" VerticalAlignment="Center"/>
                        <TextBlock Text="  Ready" Foreground="#D4E0F7" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SidebarVersionText" Text="Nova" Foreground="#8294B4" FontSize="10.5" Margin="14,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="PageHeader" Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush_202A3B}"/>
                    <TextBlock x:Name="PageSubtitle" Text="Your software at a glance. Updates and cleanup stay in your control."
                               FontSize="14" Foreground="{DynamicResource ThemeBrush_7F8BA0}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}"
                            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LAST SCAN" Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="11.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LastScanText" Text="Not scanned yet" Foreground="{DynamicResource ThemeBrush_39465B}"
                                       FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ScanButton" Content="Scan for updates" Click="ScanButton_Click" MinWidth="130"/>
                </StackPanel>
            </Grid>
            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                        SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="Dashboard">
                    <Grid x:Name="DashboardRoot" Background="#07142B">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" MinHeight="106" CornerRadius="14" BorderThickness="1"
                                BorderBrush="#24447C" Margin="0,0,0,12" Padding="20,15" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#102D63" Offset="0"/>
                                    <GradientStop Color="#0A1E42" Offset="0.57"/>
                                    <GradientStop Color="#081832" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Path Data="M 0,105 L 115,50 L 185,82 L 305,30 L 382,76 L 478,18 L 576,84 L 680,38 L 774,98 L 885,51 L 1000,105 Z"
                                      Fill="#17386D" Opacity="0.55" HorizontalAlignment="Right" Width="780"
                                      Stretch="Fill" IsHitTestVisible="False"/>
                                <Path Data="M 0,106 L 180,72 L 290,96 L 420,54 L 545,90 L 655,65 L 810,106 Z"
                                      Fill="#244A83" Opacity="0.35" HorizontalAlignment="Right" Width="780"
                                      Stretch="Fill" IsHitTestVisible="False"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="226"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="✦   WELCOME BACK" Foreground="#739AFF" FontSize="11.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="DashboardGreetingText" Text="Good morning"
                                                   Foreground="#F4F7FF" FontSize="25" FontWeight="Bold" Margin="0,5,0,2"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Your software is at a glance. Updates and system performance, all in one place."
                                                   Foreground="#CBD8F0" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Border Background="#0B1B36" BorderBrush="#203B69" BorderThickness="1"
                                                CornerRadius="9" Padding="9,5" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="▦" Foreground="#54BDFB" FontSize="17" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Last scan" Foreground="#D9E5FA" FontSize="10.5"/>
                                                    <TextBlock x:Name="DashboardLastScanText" Text="Not scanned yet"
                                                               Foreground="#9FB3D2" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="DashboardScanButton" Content="⌕   Scan for Updates"
                                                Click="ScanButton_Click" MinHeight="35" Padding="10,7"
                                                Background="#3E5FFF" Foreground="White" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0A1D43" BorderBrush="#2354B7" BorderThickness="1"
                                    CornerRadius="12" Padding="13" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11" Background="#273BC2" VerticalAlignment="Center">
                                        <TextBlock Text="⬡" Foreground="#E2E8FF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Software Installed" Foreground="#D5E2FA" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InstalledCountText" Text="—" Foreground="#F4F7FF" FontSize="23" FontWeight="Bold"/>
                                        <TextBlock x:Name="InstalledSummaryText" Text="Scan to count installed apps"
                                                   Foreground="#AABBDD" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="#062B34" BorderBrush="#087F73" BorderThickness="1"
                                    CornerRadius="12" Padding="13" Margin="6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11" Background="#087968" VerticalAlignment="Center">
                                        <TextBlock Text="⟳" Foreground="#B8FFF0" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Available Updates" Foreground="#D5F8F0" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UpdatesCountText" Text="—" Foreground="#F4FFFC" FontSize="23" FontWeight="Bold"/>
                                        <TextBlock x:Name="UpdatesSummaryText" Text="Scan to check available updates"
                                                   Foreground="#A9D8D0" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="#2D251A" BorderBrush="#C37D17" BorderThickness="1"
                                    CornerRadius="12" Padding="13" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11" Background="#A66500" VerticalAlignment="Center">
                                        <TextBlock Text="▰" Foreground="#FFF0CB" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Temporary Files" Foreground="#FFF0D5" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TempSizeText" Text="—" Foreground="#FFF9ED" FontSize="23" FontWeight="Bold"/>
                                        <TextBlock x:Name="TempCountText" Text="Scan to estimate"
                                                   Foreground="#E2C9A1" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#071A38" BorderBrush="#1A3765" BorderThickness="1"
                                    CornerRadius="14" Padding="15" Margin="0,0,7,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="System Performance" Foreground="#EEF4FF" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="Live system monitoring" Foreground="#99B2D6" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#063B46" CornerRadius="12" Padding="9,5" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#05D4A4" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashboardMonitoringStatusText" Text="  Monitoring active"
                                                           Foreground="#B5F5E7" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,7">
                                        <StackPanel Margin="3,0">
                                            <TextBlock Text="CPU Usage" Foreground="#D6E3F8" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="CpuUsageText" Text="Unavailable" Foreground="#5575FF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,3"/>
                                            <ProgressBar x:Name="CpuUsageBar" Minimum="0" Maximum="100" Height="5" Background="#142B50" Foreground="#5575FF" BorderThickness="0"/>
                                            <TextBlock x:Name="CpuTemperatureText" Text="CPU temp: Unavailable" Foreground="#91A9CE" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Margin="3,0">
                                            <TextBlock Text="GPU Usage" Foreground="#D6E3F8" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="GpuUsageText" Text="Unavailable" Foreground="#00C99C" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,3"/>
                                            <ProgressBar x:Name="GpuUsageBar" Minimum="0" Maximum="100" Height="5" Background="#142B50" Foreground="#00C99C" BorderThickness="0"/>
                                            <TextBlock x:Name="GpuTemperatureText" Text="GPU temp: Unavailable" Foreground="#91A9CE" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Margin="3,0">
                                            <TextBlock Text="VRAM Usage" Foreground="#D6E3F8" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="VramUsageText" Text="Unavailable" Foreground="#D942DE" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,3"/>
                                            <ProgressBar x:Name="VramUsageBar" Minimum="0" Maximum="100" Height="5" Background="#142B50" Foreground="#D942DE" BorderThickness="0"/>
                                            <TextBlock x:Name="VramBreakdownText" Text="Unavailable / Unavailable" Foreground="#91A9CE" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Margin="3,0">
                                            <TextBlock Text="RAM Usage" Foreground="#D6E3F8" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="RamUsageText" Text="Unavailable" Foreground="#19B8F3" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,3"/>
                                            <ProgressBar x:Name="RamUsageBar" Minimum="0" Maximum="100" Height="5" Background="#142B50" Foreground="#19B8F3" BorderThickness="0"/>
                                            <TextBlock x:Name="RamBreakdownText" Text="Unavailable / Unavailable" Foreground="#91A9CE" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Grid Grid.Row="2" Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#5575FF" VerticalAlignment="Center"/>
                                            <TextBlock Text=" CPU" Foreground="#B4C5E1" FontSize="10.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#00C99C" VerticalAlignment="Center"/>
                                            <TextBlock Text=" GPU" Foreground="#B4C5E1" FontSize="10.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#19B8F3" VerticalAlignment="Center"/>
                                            <TextBlock Text=" RAM" Foreground="#B4C5E1" FontSize="10.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#D942DE" VerticalAlignment="Center"/>
                                            <TextBlock Text=" VRAM" Foreground="#B4C5E1" FontSize="10.5"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Live usage history" Foreground="#D9E6FA" FontSize="10.5" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="PerformanceHistoryCoverageText" Text="Waiting for samples"
                                                           Foreground="#7892B8" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Button x:Name="DashboardRange1HButton" Content="1H" Tag="1"
                                                        Click="DashboardRange_Click" Padding="8,3" FontSize="10.5" Margin="2,0"
                                                        Background="#405FFF"/>
                                                <Button x:Name="DashboardRange6HButton" Content="6H" Tag="6"
                                                        Click="DashboardRange_Click" Padding="8,3" FontSize="10.5" Margin="2,0"
                                                        Background="#122546" Foreground="#A8B9D3"/>
                                                <Button x:Name="DashboardRange24HButton" Content="24H" Tag="24"
                                                        Click="DashboardRange_Click" Padding="8,3" FontSize="10.5" Margin="2,0"
                                                        Background="#122546" Foreground="#A8B9D3"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" CornerRadius="7" Background="#05132B" BorderBrush="#12294C"
                                                BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Canvas x:Name="PerformanceChart" SizeChanged="PerformanceChart_SizeChanged"
                                                        Background="Transparent" ClipToBounds="True"/>
                                                <TextBlock x:Name="PerformanceChartEmptyText" Text="Collecting live history…"
                                                           Foreground="#6F88AD" FontSize="10.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" Margin="7,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.25*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#071A38" BorderBrush="#1A3765" BorderThickness="1"
                                        CornerRadius="14" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,0,5">
                                            <TextBlock Text="System" Foreground="#EEF4FF" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="Your PC specifications" Foreground="#99B2D6" FontSize="10.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DashboardSpecifications}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="19" Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="19"/>
                                                            <ColumnDefinition Width="87"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Icon}" Foreground="#7C9FFF" FontSize="12.5" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#A8BDDC"
                                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="#D6E3F8"
                                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Value}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#071A38" BorderBrush="#1A3765" BorderThickness="1"
                                        CornerRadius="14" Padding="12" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,5">
                                            <TextBlock Text="Windows" Foreground="#EEF4FF" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="Storage &amp; OS information" Foreground="#99B2D6" FontSize="10.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding DashboardDrives}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2,8,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" Foreground="#D5E2F7" FontSize="10.5"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Used}" Foreground="#9FB4D4" FontSize="11"/>
                                                                <TextBlock Grid.Column="2" Text=" / " Foreground="#9FB4D4" FontSize="11"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Capacity}" Foreground="#9FB4D4" FontSize="11"/>
                                                            </Grid>
                                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercentage}"
                                                                         Height="4" Background="#142B50" Foreground="#4F8CFF" BorderThickness="0"
                                                                         Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,0,0">
                                            <TextBlock Text="Windows version" Foreground="#9FB4D4" FontSize="10.5"/>
                                            <TextBlock x:Name="WindowsVersionText" Text="Unavailable" Foreground="#D5E2F7"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,1,0,6"/>
                                            <TextBlock Text="System type" Foreground="#9FB4D4" FontSize="10.5"/>
                                            <TextBlock x:Name="WindowsArchitectureText" Text="Unavailable" Foreground="#D5E2F7"
                                                       FontSize="11" Margin="0,1,0,6"/>
                                            <TextBlock Text="Last boot" Foreground="#9FB4D4" FontSize="10.5"/>
                                            <TextBlock x:Name="WindowsLastBootText" Text="Unavailable" Foreground="#D5E2F7"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="My software">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="Installed apps and games" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="Detected from Windows installed-program records and your Windows app packages."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="13.5" Margin="0,5,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Software}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="*"/>
                                    <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="120"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Updates">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="Available updates" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="Scans Nova Manager, winget, Microsoft Store packages and Windows Update. App updates remain under your control; Windows updates are never installed here."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="13.5" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource ThemeBrush_F7F8FB}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nova Manager" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="13.5" FontWeight="Bold"/>
                                            <TextBlock x:Name="NovaUpdateScanStatusText" Text="Scan to check for a Nova update."
                                                       Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Nova update settings" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center" Click="OpenNovaUpdateSettings_Click"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource ThemeBrush_F7F8FB}" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Windows Update" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="13.5" FontWeight="Bold"/>
                                            <TextBlock x:Name="WindowsUpdateScanStatusText" Text="Scan to check Windows Update."
                                                       Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="OpenWindowsUpdateButton" Grid.Column="1" Content="Open Windows Update"
                                                Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                                Visibility="Collapsed" Click="OpenWindowsUpdate_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StoreUpdateScanStatusText"
                                           Text="Microsoft Store updates are checked through the Windows Package Manager Store source."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12.5" Margin="0,0,0,4"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="UpdatesGrid" ItemsSource="{Binding Updates}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="PACKAGE ID" Binding="{Binding Id}" Width="1.4*"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="105"/>
                                    <DataGridTextColumn Header="CURRENT" Binding="{Binding CurrentVersion}" Width="120"/>
                                    <DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableVersion}" Width="120"/>
                                    <DataGridTemplateColumn Header="ACTION" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Update" Padding="12,7" Tag="{Binding}" Click="UpdateButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Storage &amp; cleanup">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Storage &amp; organization" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="Explore where space is used. Unknown means needs review, not safe to delete."
                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="13.5" Margin="0,7,0,12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="TempSectionButton" Content="Temporary files" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="TempSection_Click"/>
                                <Button x:Name="FolderMapSectionButton" Content="Folder map" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="FolderMapSection_Click"/>
                                <Button x:Name="ShortcutsSectionButton" Content="Shortcuts" Style="{StaticResource SecondaryButton}"
                                        Click="ShortcutsSection_Click"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid x:Name="TempCleanupPanel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,16,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource ThemeBrush_EEF2FF}">
                                                <TextBlock Text="♻" FontSize="25" Foreground="{DynamicResource ThemeBrush_596DE0}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="Temporary Files" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                           FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text="Review scanned files and choose what to remove."
                                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="12.5"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Background="{DynamicResource ThemeBrush_F7F8FB}"
                                                BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                CornerRadius="9" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="SelectAllCleanupCheckBox" Content="Select all scanned files"
                                                          IsThreeState="True" Style="{StaticResource CleanupCheckBox}"
                                                          Click="SelectAllCleanupCheckBox_Click"/>
                                                <TextBlock Grid.Column="1" x:Name="CleanupTotalEstimateText" Text="Scan to estimate"
                                                           Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="11.5"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <DataGrid Grid.Row="2" x:Name="CleanupCategoriesGrid" ItemsSource="{Binding CleanupCategories}"
                                                  HeadersVisibility="None" MinHeight="190" RowHeight="62"
                                                  SelectionUnit="FullRow" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="4,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="38"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="86"/>
                                                                    <ColumnDefinition Width="28"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEnabled="{Binding IsSelectedAllowed}" Tag="{Binding}"
                                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                          Style="{StaticResource CleanupCheckBox}"
                                                                          Click="CleanupCategoryCheckBox_Click"/>
                                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8"
                                                                        Background="{DynamicResource ThemeBrush_EEF2FF}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Foreground="{DynamicResource ThemeBrush_596DE0}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeBrush_53627A}"
                                                                               FontSize="10.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                               MaxHeight="24"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding FormattedBytes}" Foreground="{DynamicResource ThemeBrush_202A3B}"
                                                                               FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                    <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} files}"
                                                                               Foreground="{DynamicResource ThemeBrush_53627A}" FontSize="10.5"
                                                                               HorizontalAlignment="Right"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="4" Content="›" Padding="2,0" Tag="{Binding}"
                                                                        IsEnabled="{Binding IsAvailable}" Style="{StaticResource SecondaryButton}"
                                                                        ToolTip="Open this cleanup location"
                                                                        Click="BrowseCleanupCategory_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Grid.Row="3" Margin="0,10,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Detailed file review" Foreground="{DynamicResource ThemeBrush_202A3B}" FontSize="12.5" FontWeight="Bold"/>
                                                <TextBlock x:Name="TempSelectionSummaryText" Text="Scan to review supported temporary and cache locations."
                                                           Foreground="{DynamicResource ThemeBrush_7F8BA0}" FontSize="10.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="ToggleTempFilesButton" Grid.Column="1" Content="View files"
                                                    Style="{StaticResource SecondaryButton}" Padding="9,6" Click="ToggleTempFiles_Click"/>
                                        </Grid>
                                        <DataGrid Grid.Row="4" x:Name="TempFilesGrid" ItemsSource="{Binding TempFiles}"
                                                  MinHeight="90" MaxHeight="180" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  SelectionUnit="FullRow" SelectionMode="Single"
                                                  Visibility="Collapsed">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="REMOVE" Width="68">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Tag="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Style="{StaticResource CleanupCheckBox}"
                                                                      Click="TempFileCheckBox_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="FILE PATH" Binding="{Binding Path}" Width="*"/>
                                                <DataGridTextColumn Header="SIZE" Binding="{Binding FormattedBytes}" Width="68"/>
                                                <DataGridTextColumn Header="MODIFIED" Binding="{Binding LastWriteTimeUtc, StringFormat={}{0:g}}" Width="105"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <Border Background="{DynamicResource ThemeBrush_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_E8ECF3}" BorderThickness="1"
                                                        CornerRadius="12" Padding="15" Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions>
