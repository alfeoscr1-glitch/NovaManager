<Window x:Class="NovaManager.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Feedback" Width="620" Height="500" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#07142B" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="FeedbackDialogEyebrowText" Text="FEEDBACK &amp; SUPPORT"
                       Foreground="#7C9FFF" FontSize="11.5" FontWeight="Bold"/>
            <TextBlock x:Name="FeedbackDialogTitleText" Text="Suggest a feature"
                       Foreground="#F0F5FF" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock x:Name="FeedbackDialogPromptText" Grid.Row="1" Text="Share your suggestion with the Nova team."
                   Foreground="#A8BDDC" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,9"/>
        <TextBox x:Name="FeedbackDialogInput" Grid.Row="2" MinHeight="190" MaxLength="5000"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" Padding="14" Background="#D0142A4C"
                 Foreground="#F0F5FF" BorderBrush="#80659CFF" CaretBrush="#F0F5FF"
                 ToolTip="Do not include passwords, access tokens, or sensitive information."/>
        <TextBlock Grid.Row="3"
                   Text="Your report is submitted to the Nova Manager GitHub repository. Never include passwords or tokens."
                   Foreground="#8098BA" FontSize="10.5" TextWrapping="Wrap" Margin="0,9,0,12"/>
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="FeedbackDialogStatusText" Foreground="#A8BDDC" FontSize="11.5"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="Cancel" IsCancel="True" Padding="16,9"
                    Background="#17315A" Foreground="#E2ECFF" Margin="0,0,8,0"/>
            <Button x:Name="FeedbackDialogSubmitButton" Grid.Column="2" Content="Send" IsDefault="True"
                    Padding="20,9" Click="Submit_Click"/>
        </Grid>
    </Grid>
</Window>
