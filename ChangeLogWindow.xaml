<Window x:Class="NovaManager.ChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Change Log" Width="860" Height="740" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#07142B" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#D90B1A36" BorderBrush="#80659CFF" BorderThickness="1"
                CornerRadius="16" Padding="20" Margin="0,0,0,16">
            <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NOVA SOFTWARE MANAGER" Foreground="#7C9FFF" FontSize="11.5" FontWeight="Bold"/>
                <TextBlock Text="Change log" Foreground="#F0F5FF" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Click="Close_Click" Padding="14,8"
                    Background="#17315A" Foreground="#E2ECFF" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <TextBlock x:Name="ChangeLogStatusText" Grid.Row="1" Text="Showing published Nova releases."
                   Foreground="#A8BDDC" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ScrollViewer x:Name="ChangeLogScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#D90B1A36" BorderBrush="#80659CFF" BorderThickness="1"
                                CornerRadius="14" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                                   Foreground="#F0F5FF" FontSize="18" FontWeight="Bold"/>
                                        <Border Background="#19386A" CornerRadius="9" Padding="9,4" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding ReleaseType}" Foreground="#B9C9FF"
                                                       FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PublishedAt, StringFormat={}{0:dd MMM yyyy}}"
                                               Foreground="#8FA9CC" FontSize="11.5" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Changes}" Margin="0,9,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="•" Foreground="#58A6FF" FontSize="13.5"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#CCD9EF"
                                                           FontSize="12.5" TextWrapping="Wrap" LineHeight="17"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="ChangeLogFooterText" Grid.Row="3" Text="Release dates are shown when supplied by GitHub."
                   Foreground="#7B94B7" FontSize="10.5" Margin="0,10,0,0"/>
    </Grid>
</Window>
